powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File "%GH_PS1%"
set "CODIGO=%ERRORLEVEL%"

del /q "%GH_B64%" >nul 2>&1
del /q "%GH_PS1%" >nul 2>&1

