if not "%CODIGO%"=="0" echo O processo terminou com erro. Leia a mensagem acima.
echo Esta janela permanecera aberta para voce conferir o resultado.
exit /b %CODIGO%

:ERRO_PREPARAR
set "PREP_LOG=%LOG_DIR%\ERRO_PREPARAR_%RANDOM%_%RANDOM%.txt"
if not exist "%LOG_DIR%\LOGS_PAUSADOS.flag" (
  >"%PREP_LOG%" echo DATA/HORA: %DATE% %TIME%
  >>"%PREP_LOG%" echo EVENTO: Falha ao preparar o PowerShell interno.
  >>"%PREP_LOG%" echo ARQUIVO BAT: %~f0
  >>"%PREP_LOG%" echo CODIGO: 1
)
echo.
echo Nao foi possivel preparar o programa de envio.
if exist "%PREP_LOG%" echo Log: %PREP_LOG%
echo A janela permanecera aberta para mostrar este erro.
del /q "%GH_B64%" >nul 2>&1
del /q "%GH_PS1%" >nul 2>&1
exit /b 1
